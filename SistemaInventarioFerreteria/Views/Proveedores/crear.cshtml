@model SistemaInventarioFerreteria.Models.Proveedor

@{
    ViewData["Title"] = "Nuevo Proveedor";
}

<div class="formulario-contenedor">
    <div class="formulario-encabezado">
        <h1>Nuevo proveedor</h1>
        <p>Registra un proveedor para las entradas de inventario.</p>
    </div>

    <div class="formulario-tarjeta">
        <form asp-action="crear" method="post">
            <div asp-validation-summary="ModelOnly" class="texto-error"></div>

            <div class="campo">
                <label asp-for="Nombre">Nombre del proveedor</label>
                <input asp-for="Nombre" placeholder="Ejemplo: Distribuidora Central" maxlength="150" />
                <span asp-validation-for="Nombre" class="texto-error"></span>
            </div>
            <div class="campo">
                <label asp-for="Telefono">Teléfono</label>
                <input asp-for="Telefono" type="tel" placeholder="Ejemplo: 2233-1000" maxlength="20" />
                <span asp-validation-for="Telefono" class="texto-error"></span>
            </div>
            <div class="campo">
                <label asp-for="Correo">Correo electrónico</label>
                <input asp-for="Correo" type="email" placeholder="ventas@proveedor.com" maxlength="120" />
                <span asp-validation-for="Correo" class="texto-error"></span>
            </div>
            <div class="campo">
                <label asp-for="Direccion">Dirección</label>
                <textarea asp-for="Direccion" placeholder="Dirección del proveedor" maxlength="250"></textarea>
                <span asp-validation-for="Direccion" class="texto-error"></span>
            </div>
            <div class="campo">
                <label asp-for="TiempoEntregaDias">Tiempo de entrega (días)</label>
                <input asp-for="TiempoEntregaDias" type="number" min="0" max="365" />
                <span asp-validation-for="TiempoEntregaDias" class="texto-error"></span>
            </div>
            <div class="campo-check">
                <input asp-for="Activo" type="checkbox" />
                <label asp-for="Activo">Proveedor activo</label>
            </div>

            <div class="botones-formulario">
                <button type="submit" class="boton-guardar">Guardar proveedor</button>
                <a asp-action="inicio" class="boton-regresar">Cancelar</a>
            </div>
        </form>
    </div>
</div>

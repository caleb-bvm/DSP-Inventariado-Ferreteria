@model IEnumerable<SistemaInventarioFerreteria.Models.Sucursal>

@{
    ViewData["Title"] = "Sucursales";
}

<header class="page-header">
    <div class="page-heading">
        <span class="eyebrow">Ubicaciones</span>
        <h1>Sucursales</h1>
        <p>Administra las ubicaciones donde se controla y distribuye el inventario.</p>
    </div>
    <div class="page-actions">
        <a asp-action="crear" class="btn btn-primary"><svg class="md-icon"><use href="#icon-plus"></use></svg>Agregar sucursal</a>
    </div>
</header>

<section class="metric-grid" aria-label="Resumen de sucursales">
    <article class="metric-card">
        <div class="metric-copy"><span class="metric-label">Total sucursales</span><strong class="metric-value">@Model.Count()</strong><span class="metric-note">Ubicaciones registradas</span></div>
        <span class="metric-icon"><svg class="md-icon"><use href="#icon-branch"></use></svg></span>
    </article>
    <article class="metric-card">
        <div class="metric-copy"><span class="metric-label">Sucursales activas</span><strong class="metric-value">@Model.Count(s => s.Activo)</strong><span class="metric-note">Disponibles para operar</span></div>
        <span class="metric-icon"><svg class="md-icon"><use href="#icon-check"></use></svg></span>
    </article>
    <article class="metric-card">
        <div class="metric-copy"><span class="metric-label">Sucursales inactivas</span><strong class="metric-value">@Model.Count(s => !s.Activo)</strong><span class="metric-note">Fuera de operación</span></div>
        <span class="metric-icon"><svg class="md-icon"><use href="#icon-warning"></use></svg></span>
    </article>
</section>

<section class="contenedor-tabla">
    <div class="titulo-tabla">
        <div><h2>Listado de sucursales</h2><p>Dirección, contacto y estado de cada ubicación.</p></div>
        <span class="status-badge status-active">@Model.Count() registros</span>
    </div>
    <div class="table-scroll">
        <table class="data-table">
            <thead><tr><th>ID</th><th>Sucursal</th><th>Dirección</th><th>Teléfono</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="empty-state"><strong>Aún no hay sucursales</strong>Agrega una ubicación para controlar su inventario.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="entity-id">#@item.IdSucursal</td>
                            <td><div class="entity-cell"><span class="entity-avatar">@item.Nombre.Substring(0, 1).ToUpper()</span><strong>@item.Nombre</strong></div></td>
                            <td class="muted-text">@(item.Direccion ?? "Sin dirección")</td>
                            <td>@(item.Telefono ?? "Sin teléfono")</td>
                            <td>@if (item.Activo) { <span class="status-badge status-active">Activa</span> } else { <span class="status-badge status-inactive">Inactiva</span> }</td>
                            <td>
                                <div class="table-actions">
                                    <a asp-action="detalles" asp-route-id="@item.IdSucursal" class="action-button action-view" aria-label="Ver @item.Nombre"><svg class="md-icon"><use href="#icon-view"></use></svg><span>Ver</span></a>
                                    <a asp-action="editar" asp-route-id="@item.IdSucursal" class="action-button action-edit" aria-label="Editar @item.Nombre"><svg class="md-icon"><use href="#icon-edit"></use></svg><span>Editar</span></a>
                                    <a asp-action="eliminar" asp-route-id="@item.IdSucursal" class="action-button action-delete" aria-label="Eliminar @item.Nombre"><svg class="md-icon"><use href="#icon-delete"></use></svg><span>Eliminar</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

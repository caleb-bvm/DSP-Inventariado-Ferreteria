@model IEnumerable<SistemaInventarioFerreteria.Models.Productos>

@{
    ViewData["Title"] = "Productos";
}

<header class="page-header">
    <div class="page-heading">
        <span class="eyebrow">Catálogo</span>
        <h1>Productos</h1>
        <p>Consulta y administra todos los productos registrados en el sistema.</p>
    </div>
    <div class="page-actions">
        <a asp-action="crear" class="btn btn-primary">
            <svg class="md-icon"><use href="#icon-plus"></use></svg>
            Agregar producto
        </a>
    </div>
</header>

<section class="metric-grid" aria-label="Resumen de productos">
    <article class="metric-card">
        <div class="metric-copy"><span class="metric-label">Total productos</span><strong class="metric-value">@Model.Count()</strong><span class="metric-note">En el catálogo</span></div>
        <span class="metric-icon"><svg class="md-icon"><use href="#icon-package"></use></svg></span>
    </article>
    <article class="metric-card">
        <div class="metric-copy"><span class="metric-label">Productos activos</span><strong class="metric-value">@Model.Count(p => p.Activo)</strong><span class="metric-note">Disponibles para operar</span></div>
        <span class="metric-icon"><svg class="md-icon"><use href="#icon-check"></use></svg></span>
    </article>
    <article class="metric-card">
        <div class="metric-copy"><span class="metric-label">Productos inactivos</span><strong class="metric-value">@Model.Count(p => !p.Activo)</strong><span class="metric-note">Fuera de operación</span></div>
        <span class="metric-icon"><svg class="md-icon"><use href="#icon-warning"></use></svg></span>
    </article>
</section>

<section class="contenedor-tabla">
    <div class="titulo-tabla">
        <div><h2>Listado de productos</h2><p>Información general, categoría y estado de cada registro.</p></div>
        <span class="status-badge status-active">@Model.Count() registros</span>
    </div>
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr><th>ID</th><th>Producto</th><th>Descripción</th><th>Categoría</th><th>Estado</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="empty-state"><strong>Aún no hay productos</strong>Agrega el primer producto para comenzar a organizar el catálogo.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="entity-id">#@item.IdProducto</td>
                            <td><div class="entity-cell"><span class="entity-avatar">@item.Nombre.Substring(0, 1).ToUpper()</span><strong>@item.Nombre</strong></div></td>
                            <td class="muted-text">@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)</td>
                            <td>@(item.Categoria?.Nombre ?? "Sin categoría")</td>
                            <td>
                                @if (item.Activo) { <span class="status-badge status-active">Activo</span> }
                                else { <span class="status-badge status-inactive">Inactivo</span> }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a asp-action="detalles" asp-route-id="@item.IdProducto" class="action-button action-view" aria-label="Ver @item.Nombre"><svg class="md-icon"><use href="#icon-view"></use></svg><span>Ver</span></a>
                                    <a asp-action="editar" asp-route-id="@item.IdProducto" class="action-button action-edit" aria-label="Editar @item.Nombre"><svg class="md-icon"><use href="#icon-edit"></use></svg><span>Editar</span></a>
                                    <a asp-action="eliminar" asp-route-id="@item.IdProducto" class="action-button action-delete" aria-label="Eliminar @item.Nombre"><svg class="md-icon"><use href="#icon-delete"></use></svg><span>Eliminar</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@model SistemaInventarioFerreteria.Models.EntradaInventario

@{
    ViewData["Title"] = "Editar entrada";
}

<div class="formulario-contenedor">
    <div class="formulario-encabezado">
        <h1>Editar entrada</h1>
        <p>La diferencia de cantidad se aplicará automáticamente al inventario.</p>
    </div>

    <div class="formulario-tarjeta">
        <form asp-action="editar"
              asp-route-id="@Model.IdEntrada"
              method="post">

            <input type="hidden" asp-for="IdEntrada" />

            <div asp-validation-summary="ModelOnly"
                 class="texto-error"></div>

            <div class="campo">
                <label asp-for="IdVariante">Variante</label>
                <select asp-for="IdVariante"
                        asp-items="ViewBag.Variantes">
                    <option value="">Seleccione una variante</option>
                </select>
                <span asp-validation-for="IdVariante"
                      class="texto-error"></span>
            </div>

            <div class="campo">
                <label asp-for="IdSucursal">Sucursal</label>
                <select asp-for="IdSucursal"
                        asp-items="ViewBag.Sucursales">
                    <option value="">Seleccione una sucursal</option>
                </select>
                <span asp-validation-for="IdSucursal"
                      class="texto-error"></span>
            </div>

            <div class="campo">
                <label asp-for="IdProveedor">Proveedor</label>
                <select asp-for="IdProveedor"
                        asp-items="ViewBag.Proveedores">
                    <option value="">Sin proveedor</option>
                </select>
                <span asp-validation-for="IdProveedor"
                      class="texto-error"></span>
            </div>

            <div class="campo">
                <label asp-for="Cantidad">Cantidad</label>
                <input asp-for="Cantidad"
                       type="number"
                       min="1" />
                <span asp-validation-for="Cantidad"
                      class="texto-error"></span>
            </div>

            <div class="campo">
                <label asp-for="CostoUnitario">Costo unitario</label>
                <input asp-for="CostoUnitario"
                       type="number"
                       min="0.01"
                       step="0.01" />
                <span asp-validation-for="CostoUnitario"
                      class="texto-error"></span>
            </div>

            <div class="campo">
                <label asp-for="Fecha">Fecha</label>
                <input asp-for="Fecha"
                       type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <span asp-validation-for="Fecha"
                      class="texto-error"></span>
            </div>

            <div class="botones-formulario">
                <button type="submit" class="boton-guardar">
                    Guardar cambios
                </button>
                <a asp-action="inicio" class="boton-regresar">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
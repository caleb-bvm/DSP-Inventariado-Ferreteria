@model SistemaInventarioFerreteria.Models.Marca

@{
    ViewData["Title"] = "Eliminar Marca";
}

<div class="formulario-contenedor">
    <div class="formulario-encabezado">
        <h1>Eliminar marca</h1>
        <p>Confirma la eliminación del registro seleccionado.</p>
    </div>

    <div class="formulario-tarjeta">
        <div asp-validation-summary="ModelOnly" class="texto-error"></div>

        <div class="mensaje-eliminar">
            <h2>¿Deseas eliminar esta marca?</h2>
            <p>La acción no se puede deshacer y solo será posible si la marca no está en uso.</p>
        </div>

        <div class="detalle-fila">
            <span class="detalle-etiqueta">ID</span>
            <span class="detalle-valor">#@Model.IdMarca</span>
        </div>
        <div class="detalle-fila">
            <span class="detalle-etiqueta">Nombre</span>
            <span class="detalle-valor">@Model.Nombre</span>
        </div>

        <form asp-action="eliminar" asp-route-id="@Model.IdMarca" method="post">
            <div class="botones-formulario">
                <button type="submit" class="boton-eliminar">Eliminar</button>
                <a asp-action="inicio" class="boton-regresar">Cancelar</a>
            </div>
        </form>
    </div>
</div>

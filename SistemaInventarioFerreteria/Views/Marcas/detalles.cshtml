@model SistemaInventarioFerreteria.Models.Marca

@{
    ViewData["Title"] = "Detalles de Marca";
}

<div class="formulario-contenedor">
    <div class="formulario-encabezado">
        <h1>Detalles de la marca</h1>
        <p>Consulta la información registrada de la marca.</p>
    </div>

    <div class="formulario-tarjeta">
        <div class="detalle-fila">
            <span class="detalle-etiqueta">ID</span>
            <span class="detalle-valor">#@Model.IdMarca</span>
        </div>
        <div class="detalle-fila">
            <span class="detalle-etiqueta">Nombre</span>
            <span class="detalle-valor">@Model.Nombre</span>
        </div>

        <div class="botones-formulario">
            <a asp-action="editar" asp-route-id="@Model.IdMarca" class="boton-guardar">Editar</a>
            <a asp-action="inicio" class="boton-regresar">Regresar</a>
        </div>
    </div>
</div>
